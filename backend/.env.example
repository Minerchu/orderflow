# ============================================================
# OrderFlow - Telegram Order Management & Settlement System
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- App ----
APP_ENV=development
APP_SECRET_KEY=replace_me
# PUBLIC URL of this deployment. Required for Telegram to deliver button taps:
# e.g. https://order.example.com  (plain host is upgraded to https automatically)
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=replace_me_session
# Register the callback webhook with Telegram on startup (recommended: true).
# Set false only if you register it yourself.
AUTO_REGISTER_WEBHOOK=true

# ---- Database ----
# Production (Docker Compose):
# DATABASE_URL=postgresql+psycopg://postgres:replace_me@db:5432/orderflow
# Local dev / tests (zero-dependency SQLite fallback):
DATABASE_URL=sqlite:///./orderflow.db

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
ADMIN_TELEGRAM_USER_IDS=
# Optional outbound proxy for api.telegram.org. Required if the server cannot
# reach Telegram directly (e.g. blocks it or has no route).
#   TELEGRAM_PROXY=socks5://user:pass@host:1080
#   TELEGRAM_PROXY=http://user:pass@host:8080
TELEGRAM_PROXY=

# ---- i18n & Currency ----
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD
TELEGRAM_MESSAGE_LANGUAGE=en

# ---- Group message display ----
SHOW_ORDER_ID_IN_GROUP=false
# 已填写账号、密码默认发送至目标群，群成员可见；设为 false 可关闭。
SHOW_CREDENTIALS_IN_GROUP=true
SHOW_PASSWORD_IN_GROUP=true

# ---- Group member permissions ----
ALLOW_ANY_GROUP_MEMBER_TO_COMPLETE=false
ALLOW_ANY_GROUP_MEMBER_TO_FAIL=false
ALLOW_ANY_GROUP_MEMBER_TO_REOPEN=false
ALLOW_ANY_GROUP_MEMBER_TO_CLOSE=false

# ---- Storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data/uploads
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=10
