# ===========================================================================
# OrderFlow — Docker Compose environment
#
#   cp .env.example .env
#   # edit the REQUIRED values below, then: docker compose up -d --build
#
# Never commit the resulting .env file.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED — the stack refuses to start without these
# ---------------------------------------------------------------------------

# Database password (also embedded into the backend's DATABASE_URL).
POSTGRES_PASSWORD=change_me_to_a_long_random_string

# Signing keys. Generate fresh ones, e.g.:
#   docker run --rm python:3.13-slim \
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_a_different_long_random_string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=production
# PUBLIC HTTPS address of this deployment, e.g. https://order.example.com
# Telegram requires a public HTTPS URL to deliver group button taps, so this
# value decides whether 接单/完成/失败 work at all.
# You may also set it later in 系统设置 → 按钮回调 (stored in the DB, no restart).
APP_BASE_URL=http://localhost
# Register the Telegram callback webhook on startup.
AUTO_REGISTER_WEBHOOK=true

# Host port for the web UI.
HTTP_PORT=80

# ---------------------------------------------------------------------------
# Telegram bot
#   TELEGRAM_ALLOWED_CHAT_IDS: comma-separated whitelist of group chat ids,
#   e.g. -1001234567890,-1009876543210
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
ADMIN_TELEGRAM_USER_IDS=
# Outbound proxy for api.telegram.org. REQUIRED if the server cannot reach
# Telegram directly (e.g. it is blocked, or there is no route out).
#   TELEGRAM_PROXY=socks5://user:pass@host:1080
#   TELEGRAM_PROXY=http://user:pass@host:8080
# Leave empty when the server has direct access.
TELEGRAM_PROXY=

# ---------------------------------------------------------------------------
# i18n & currency
# ---------------------------------------------------------------------------
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD
TELEGRAM_MESSAGE_LANGUAGE=en

# ---------------------------------------------------------------------------
# What the group message shows
# ---------------------------------------------------------------------------
SHOW_ORDER_ID_IN_GROUP=false
# 已填写账号、密码默认发送至目标群，群成员可见；设为 false 可关闭。
SHOW_CREDENTIALS_IN_GROUP=true
SHOW_PASSWORD_IN_GROUP=true

# ---------------------------------------------------------------------------
# What any (unregistered) group member is allowed to do
# ---------------------------------------------------------------------------
ALLOW_ANY_GROUP_MEMBER_TO_COMPLETE=false
ALLOW_ANY_GROUP_MEMBER_TO_FAIL=false
ALLOW_ANY_GROUP_MEMBER_TO_REOPEN=false
ALLOW_ANY_GROUP_MEMBER_TO_CLOSE=false

# ---------------------------------------------------------------------------
# Storage — "local" (volume) or "s3"
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
